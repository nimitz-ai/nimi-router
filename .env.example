# Key clients must send as `Authorization: Bearer <key>`. Leave empty for open access (dev only).
ROUTER_API_KEY=

# Password protecting this dashboard. Leave empty for no login.
DASHBOARD_PASSWORD=

# JSON array of providers. Lower priority = tried first.
# Each provider can hold MULTIPLE apiKeys — requests rotate round-robin across
# them, and a key that errors (429/401/5xx) is cooled down automatically.
# Any OpenAI-compatible endpoint works.
PROVIDERS_JSON=[
  {
    "name": "OpenAI",
    "baseUrl": "https://api.openai.com/v1",
    "apiKeys": ["sk-aaa", "sk-bbb", "sk-ccc"],
    "models": ["gpt-4o-mini", "gpt-4o"],
    "priority": 1,
    "enabled": true
  },
  {
    "name": "OpenRouter",
    "baseUrl": "https://openrouter.ai/api/v1",
    "apiKey": "sk-or-...",
    "models": ["*"],
    "priority": 2,
    "enabled": true
  }
]
